generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Tenancy
//
// Tenant = cliente suscripto (la empresa que contrata el SaaS).
// Company = firma / razon social, subdividida dentro de un tenant.
//   Vision: "Aislamiento estricto de datos por cliente suscripto (tenant) con
//   capacidad de subdividir operaciones en multiples razones sociales."
//
// Regla de scope:
//   - Tenant-owned roots llevan `tenantId` explicito: Company, User, Client,
//     Input, LaborType.
//   - El resto deriva su tenant por la cadena de padres (Farm -> Client,
//     Lot -> Farm -> Client, Task -> Lot -> ..., Machine -> Company, etc.).
//   - La firma operativa vive en Company y se referencia donde el negocio la
//     necesita (Machine, DailyReport, MachineActivity), nunca en Farm.
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  companies  Company[]
  users      User[]
  clients    Client[]
  inputs     Input[]
  inputCategories InputCategory[]
  laborTypes LaborType[]
  expenseCategories ExpenseCategory[]
}

model Company {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  cuit      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  userCompanies     UserCompany[]
  machines          Machine[]
  maintenanceThresholds MaintenanceThreshold[]
  machineActivities MachineActivity[]
  dailyReports      DailyReport[]
  livestock         Livestock[]
  modules           Module[]
  tariffs           Tariff[]
  expenses          Expense[]

  @@index([tenantId])
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  username            String?   @unique
  email               String    @unique
  passwordHash        String
  role                UserRole
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  version             Int       @default(1)
  deleted             Boolean   @default(false)

  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  companyMemberships  UserCompany[]
  refreshTokens       RefreshToken[]
  livestockEvents     LivestockEvent[]
  tasks               Task[]           @relation("TaskOperators")
  weightRecords       WeightRecord[]
  dailyReports        DailyReport[]    @relation("DailyReportOperator")
  approvedReports     DailyReport[]    @relation("DailyReportApprover")
  validatedReceptions Reception[]      @relation("ReceptionValidator")
  client              Client?

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Module {
  id        String    @id @default(uuid())
  name      String
  price     Float
  version   String
  createdAt DateTime  @default(now())
  companies Company[] @relation()
}

// ============================================================================
// Catalogos (tenant-owned, con version + deleted para pull versionado)
// ============================================================================

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  userId    String?  @unique
  cuit      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  farms      Farm[]
  receptions Reception[]
  stocks     Stock[]

  @@index([tenantId])
}

model InputCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  inputs Input[]
  laborTypeCategories LaborTypeCategory[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Input {
  id        String   @id @default(uuid())
  tenantId  String
  categoryId String
  name      String
  unit      InputUnit
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  category         InputCategory      @relation(fields: [categoryId], references: [id])
  recipeItems      RecipeItem[]
  dailyReportItems DailyReportItem[]
  receptionItems   ReceptionItem[]
  stocks           Stock[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
}

model LaborType {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  // Un tipo de labor puede exigir receta fitosanitaria (modulo de recetas).
  requiresPrescription Boolean @default(false)
  // Clase semantica de la labor, deliberadamente separada del nombre: el
  // inquilino puede renombrar "Siembra" y el significado tiene que sobrevivir.
  // OTRO = sin clasificar.
  kind        LaborKind @default(OTRO)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  deleted     Boolean  @default(false)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  tasks        Task[]
  dailyReports DailyReport[]
  categories   LaborTypeCategory[]
  tariffs      Tariff[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model LaborTypeCategory {
  laborTypeId String
  categoryId  String

  laborType LaborType     @relation(fields: [laborTypeId], references: [id], onDelete: Cascade)
  category  InputCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([laborTypeId, categoryId])
  @@index([categoryId])
}

// ============================================================================
// Campo / Lote
// ============================================================================

model Farm {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  location  String?
  surface   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  client Client @relation(fields: [clientId], references: [id])
  lots   Lot[]

  @@index([clientId])
}

model Lot {
  id        String   @id @default(uuid())
  farmId    String
  name      String
  // Legado: texto de display en DMS (ej. "33° 23' S · 62° 18' O"), no es dato
  // geoespacial ni se puede convertir a geometria. Se deprecia, nunca se borra:
  // el cliente movil lo persiste como columna drift.
  coords    String?
  // Poligono GeoJSON (RFC 7946) validado en dominio. Nullable a proposito: CUU02
  // dice que crear el lote y delimitar su poligono son momentos distintos.
  polygon   Json?
  area      Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  farm         Farm                @relation(fields: [farmId], references: [id])
  movements    LivestockMovement[]
  tasks        Task[]
  livestock    Livestock[]         @relation("LotLivestock")
  recipes      Recipe[]
  dailyReports DailyReport[]
  expenses     Expense[]

  @@index([farmId])
}

// ============================================================================
// Tareas (pre-Sprint 2) — la firma NO vive aca: se resuelve en DailyReport
// ============================================================================

model Task {
  id            String     @id @default(uuid())
  lotId         String
  laborTypeId   String
  status        TaskStatus @default(PENDIENTE)
  prescriptionStatus PrescriptionStatus @default(NO_REQUIERE)
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedTaskAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  version       Int        @default(1)
  deleted       Boolean    @default(false)

  lot          Lot            @relation(fields: [lotId], references: [id])
  laborType    LaborType      @relation(fields: [laborTypeId], references: [id])
  operators    User[]         @relation("TaskOperators")
  machineLogs  MachineUsage[]
  dailyReports DailyReport[]
  recipe       Recipe?

  @@index([lotId])
  @@index([laborTypeId])
  @@index([status])
  @@index([prescriptionStatus])
}

// ============================================================================
// Produccion (CUU05) — R007, R008, R009
// ============================================================================

model Recipe {
  id              String       @id @default(uuid())
  lotId           String
  taskId          String?      @unique
  date            DateTime
  status          RecipeStatus @default(ACTIVA)
  observations    String?
  pest            String?
  crop            String?
  reapplicationIntervalDays Int?
  reapplicationDate DateTime?
  sprayVolume     Float
  sprayVolumeUnit String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lot   Lot          @relation(fields: [lotId], references: [id])
  task  Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  items RecipeItem[]

  @@index([lotId])
  @@index([lotId, date])
}

model RecipeItem {
  id        String  @id @default(uuid())
  recipeId  String
  inputId   String
  dose      Float
  dosageBasis DosageBasis @default(POR_HECTAREA)
  unit      String?
  loadOrder Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  input  Input  @relation(fields: [inputId], references: [id])

  @@index([recipeId])
  @@index([inputId])
}

model DailyReport {
  id              String            @id @default(uuid())
  operatorId      String
  companyId       String
  taskId          String
  lotId           String
  laborTypeId     String
  date            DateTime
  hectares        Float
  hours           Float
  status          DailyReportStatus @default(PENDIENTE_APROBACION)
  rejectionReason String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  operator  User              @relation("DailyReportOperator", fields: [operatorId], references: [id])
  approver  User?             @relation("DailyReportApprover", fields: [approvedBy], references: [id])
  company   Company           @relation(fields: [companyId], references: [id])
  task      Task              @relation(fields: [taskId], references: [id])
  lot       Lot               @relation(fields: [lotId], references: [id])
  laborType LaborType         @relation(fields: [laborTypeId], references: [id])
  items     DailyReportItem[]
  valuation DailyReportValuation?

  @@index([companyId, date])
  @@index([status, date])
  @@index([taskId])
  @@index([lotId])
  @@index([operatorId])
}

model DailyReportItem {
  id            String @id @default(uuid())
  dailyReportId String
  inputId       String
  quantity      Float
  unit          String

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  input       Input       @relation(fields: [inputId], references: [id])

  @@index([dailyReportId])
  @@index([inputId])
}

// ============================================================================
// Insumos / Stock (CUU06, CUU07) — R014, R015, R017
// ============================================================================

model Reception {
  id              String          @id @default(uuid())
  clientId        String
  date            DateTime
  status          ReceptionStatus @default(PENDIENTE_VALIDACION)
  rejectionReason String?
  validatedBy     String?
  validatedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client    Client          @relation(fields: [clientId], references: [id])
  validator User?           @relation("ReceptionValidator", fields: [validatedBy], references: [id])
  items     ReceptionItem[]

  @@index([clientId])
  @@index([status])
}

model ReceptionItem {
  id                String @id @default(uuid())
  receptionId       String
  inputId           String
  // Expected quantity declared by the client when the reception is created
  // (R014, CUU06). It is the audit reference, not the amount that enters stock.
  quantity          Float
  // Quantity agreed by the administrator when the reception is validated
  // (mutuo acuerdo, R014). It is what enters the client stock (R017/CUU07), and
  // the shortage/surplus of the item is observable as validatedQuantity -
  // quantity (R015). Null while the reception is PENDIENTE_VALIDACION.
  validatedQuantity Float?
  unit              String

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  input     Input     @relation(fields: [inputId], references: [id])

  @@index([receptionId])
  @@index([inputId])
}

// Stock atribuido al cliente a nivel global (suma para todos sus lotes),
// no por lote individual (CUU06) y sin particion por firma (CUU07 es filtro
// de reporte, no de saldo).
model Stock {
  id        String   @id @default(uuid())
  clientId  String
  inputId   String
  quantity  Float
  unit      InputUnit
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  input  Input  @relation(fields: [inputId], references: [id])

  @@unique([clientId, inputId])
  @@index([inputId])
}

// ============================================================================
// Maquinaria (CUU08) — R018, R019, R020, R021
// ============================================================================

model Machine {
  id              String        @id @default(uuid())
  companyId       String
  name            String
  type            String?
  brand           String?
  status          MachineStatus @default(ACTIVA)
  entryDate       DateTime?
  maintenanceDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  version         Int           @default(1)
  deleted         Boolean       @default(false)

  company           Company           @relation(fields: [companyId], references: [id])
  usages            MachineUsage[]
  machineActivities MachineActivity[]

  @@index([companyId])
}

model MaintenanceThreshold {
  id            String   @id @default(uuid())
  companyId     String
  machineType   String
  hoursLimit    Float?
  hectaresLimit Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, machineType])
}

model MachineUsage {
  id           String   @id @default(uuid())
  taskId       String
  machineId    String
  initialFuel  Float?
  finalFuel    Float?
  usageHours   Float?
  hectares     Float?
  observations String?
  operatorId   String?
  workDate     DateTime?
  createdAt    DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  task    Task    @relation(fields: [taskId], references: [id])

  @@index([machineId])
  @@index([taskId])
}

// Actividad de maquinaria NO atada a una tarea (compra de combustible,
// mantenimiento, reparacion). `companyId` es obligatorio porque R019 exige
// discriminar el gasto por firma.
model MachineActivity {
  id           String              @id @default(uuid())
  machineId    String
  companyId    String
  type         MachineActivityType
  fuelMovement FuelMovement?
  date         DateTime
  liters       Float?
  receipt      String?
  receiptFileKey String? @unique
  receiptMimeType String?
  cost         Float?
  spareParts   String?
  usageHours   Float?
  hectares     Float?
  observations String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([machineId, date])
  @@index([companyId])
  @@index([type, date])
}

// ============================================================================
// Infraestructura
// ============================================================================

// Foto polimorfica: no lleva FK porque apunta a distintas entidades.
model Photo {
  id         String          @id @default(uuid())
  entityType PhotoEntityType
  entityId   String
  localPath  String
  orderIndex Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
}

// ============================================================================
// Ganadero (fuera del contrato actual; se mantiene operativo)
// ============================================================================

model Livestock {
  id        String          @id @default(uuid())
  companyId String
  lotId     String?
  tagNumber String          @unique
  species   String
  breed     String?
  sex       String
  birthDate DateTime?
  status    LivestockStatus @default(ACTIVO)
  entryDate DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  version   Int             @default(1)
  deleted   Boolean         @default(false)

  company   Company             @relation(fields: [companyId], references: [id])
  events    LivestockEvent[]
  movements LivestockMovement[]
  weights   WeightRecord[]
  lot       Lot?                @relation("LotLivestock", fields: [lotId], references: [id])

  @@index([companyId])
  @@index([lotId])
}

model LivestockEvent {
  id           String    @id @default(uuid())
  livestockId  String
  operatorId   String?
  type         EventType
  observations String?
  vaccine      String?
  dose         Float?
  eventDate    DateTime
  createdAt    DateTime  @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id])
  operator  User?     @relation(fields: [operatorId], references: [id])

  @@index([livestockId])
}

model WeightRecord {
  id          String   @id @default(uuid())
  livestockId String
  operatorId  String?
  weight      Float
  measuredAt  DateTime
  createdAt   DateTime @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id])
  operator  User?     @relation(fields: [operatorId], references: [id])

  @@index([livestockId])
}

model LivestockMovement {
  id           String   @id @default(uuid())
  livestockId  String
  lotId        String
  movementDate DateTime
  observations String?
  createdAt    DateTime @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id])
  lot       Lot       @relation(fields: [lotId], references: [id])

  @@index([livestockId])
  @@index([lotId])
}

// ============================================================================
// Enums (valores en espanol)
// ============================================================================

enum UserRole {
  ADMIN
  OPERARIO
  SUPERVISOR
  PRODUCTOR
  CONTRATISTA
  VETERINARIO
  INGENIERO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  FINALIZADA
  CANCELADA
}

enum LivestockStatus {
  ACTIVO
  VENDIDO
  MUERTO
  ENFERMO
}

enum MachineStatus {
  ACTIVA
  MANTENIMIENTO
  FUERA_SERVICIO
}

enum EventType {
  VACUNACION
  TRATAMIENTO
  CASTRACION
  INSEMINACION
  PARTO
  ENFERMEDAD
}

enum DailyReportStatus {
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
}

enum ReceptionStatus {
  PENDIENTE_VALIDACION
  VALIDADA
  RECHAZADA
}

enum MachineActivityType {
  COMBUSTIBLE
  MANTENIMIENTO
  REPARACION
  USO_CAMPO
}

enum FuelMovement {
  INCOME
  CONSUMPTION
}

enum PhotoEntityType {
  PARTE_DIARIO
  RECEPCION
  ACTIVIDAD_MAQUINARIA
}

enum RecipeStatus {
  ACTIVA
  ARCHIVADA
}

enum PrescriptionStatus {
  NO_REQUIERE
  SIN_RECETA
  CON_RECETA
}

enum DosageBasis {
  POR_HECTAREA
  CONCENTRACION
}

enum InputUnit {
  L
  KG
  UNIT
}

// Clase semantica de una labor, para derivar el estado agronomico del lote sin
// depender del texto de LaborType.name, que el inquilino puede renombrar.
enum LaborKind {
  SIEMBRA
  PULVERIZACION
  FERTILIZACION
  COSECHA
  OTRO
}

// ============================================================================
// Finanzas: tarifario (Sprint 4, Unidad 1)
//
// Una tarifa por par firma + tipo de labor. Precio y costo estandar llevan cada
// uno su propia base y moneda (ARS, USD o kilos de un grano de la pizarra).
// Los montos son Decimal(18,4); en la API viajan como strings decimales.
// El CHECK de grano (grano obligatorio solo en KG_CEREAL) y los montos >= 0
// viven en la migracion SQL, porque Prisma no los expresa.
// ============================================================================

enum MoneyUnit {
  ARS
  USD
  KG_CEREAL
}

enum Grain {
  TRIGO
  MAIZ
  GIRASOL
  SOJA
  SORGO
}

enum TariffBasis {
  POR_HECTAREA
  POR_HORA
}

enum UsdRateType {
  OFICIAL_VENTA
  OFICIAL_COMPRA
  BNA_PIZARRA
}

model Tariff {
  id          String      @id @default(uuid())
  companyId   String
  laborTypeId String
  priceAmount Decimal     @db.Decimal(18, 4)
  priceUnit   MoneyUnit
  priceGrain  Grain?
  priceBasis  TariffBasis
  costAmount  Decimal     @db.Decimal(18, 4)
  costUnit    MoneyUnit
  costGrain   Grain?
  costBasis   TariffBasis
  updatedBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  laborType  LaborType              @relation(fields: [laborTypeId], references: [id])
  valuations DailyReportValuation[]

  @@unique([companyId, laborTypeId])
}

enum ValuationOrigin {
  APROBACION
  REINTENTO
}

model DailyReportValuation {
  id            String          @id @default(uuid())
  dailyReportId String          @unique
  companyId     String
  lotId         String
  tariffId      String?
  origin        ValuationOrigin

  priceAmount Decimal     @db.Decimal(18, 4)
  priceUnit   MoneyUnit
  priceGrain  Grain?
  priceBasis  TariffBasis
  costAmount  Decimal     @db.Decimal(18, 4)
  costUnit    MoneyUnit
  costGrain   Grain?
  costBasis   TariffBasis

  hectares     Decimal @db.Decimal(18, 4)
  hours        Decimal @db.Decimal(18, 4)
  incomeNative Decimal @db.Decimal(18, 4)
  costNative   Decimal @db.Decimal(18, 4)

  incomeGrainArsPerTon Decimal?     @db.Decimal(18, 4)
  costGrainArsPerTon   Decimal?     @db.Decimal(18, 4)
  usdRate              Decimal?     @db.Decimal(18, 4)
  usdRateType          UsdRateType?
  grainSource          String?
  usdSource            String?
  priceFetchedAt       DateTime?
  priceStale           Boolean      @default(false)

  incomeArs Decimal  @db.Decimal(18, 4)
  costArs   Decimal  @db.Decimal(18, 4)
  valuedAt  DateTime
  createdAt DateTime @default(now())

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id])
  tariff      Tariff?     @relation(fields: [tariffId], references: [id], onDelete: SetNull)

  @@index([companyId, lotId])
}

// ============================================================================
// Sprint 4, Unidad 3: gastos manuales por lote y sugerencias del supervisor.
// El gasto se da de baja de forma logica (deletedAt/deletedBy) para que la
// sugerencia aprobada conserve su historial: por eso la sugerencia NO cascadea.
// El indice unico parcial "una sugerencia PENDIENTE por gasto" y los CHECK de
// grano/monto viven en la migracion SQL, porque Prisma no los expresa.
// ============================================================================

enum ExpenseSuggestionKind {
  EDICION
  BAJA
}

enum ExpenseSuggestionStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Expense {
  id             String       @id @default(uuid())
  companyId      String
  lotId          String
  categoryId     String
  date           DateTime
  description    String
  amount         Decimal      @db.Decimal(18, 4)
  unit           MoneyUnit
  grain          Grain?
  grainArsPerTon Decimal?     @db.Decimal(18, 4)
  usdRate        Decimal?     @db.Decimal(18, 4)
  usdRateType    UsdRateType?
  priceSource    String?
  priceFetchedAt DateTime?
  priceStale     Boolean      @default(false)
  amountArs      Decimal      @db.Decimal(18, 4)
  valuedAt       DateTime
  createdBy      String
  updatedBy      String
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  lot         Lot                 @relation(fields: [lotId], references: [id])
  category    ExpenseCategory     @relation(fields: [categoryId], references: [id])
  suggestions ExpenseSuggestion[]

  @@index([companyId, lotId, date])
  @@index([categoryId])
}

model ExpenseSuggestion {
  id                  String                  @id @default(uuid())
  expenseId           String
  companyId           String
  kind                ExpenseSuggestionKind
  status              ExpenseSuggestionStatus @default(PENDIENTE)
  proposedLotId       String?
  proposedCategoryId  String?
  proposedDate        DateTime?
  proposedDescription String?
  proposedAmount      Decimal?                @db.Decimal(18, 4)
  proposedUnit        MoneyUnit?
  proposedGrain       Grain?
  suggestedBy         String
  rejectionReason     String?
  resolvedBy          String?
  resolvedAt          DateTime?
  createdAt           DateTime                @default(now())

  expense Expense @relation(fields: [expenseId], references: [id])

  @@index([companyId, status])
  @@index([suggestedBy])
  @@index([expenseId])
}
