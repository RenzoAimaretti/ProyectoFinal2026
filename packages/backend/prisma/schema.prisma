generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Tenancy
//
// Tenant = cliente suscripto (la empresa que contrata el SaaS).
// Company = firma / razon social, subdividida dentro de un tenant.
//   Vision: "Aislamiento estricto de datos por cliente suscripto (tenant) con
//   capacidad de subdividir operaciones en multiples razones sociales."
//
// Regla de scope:
//   - Tenant-owned roots llevan `tenantId` explicito: Company, User, Client,
//     Input, LaborType.
//   - El resto deriva su tenant por la cadena de padres (Farm -> Client,
//     Lot -> Farm -> Client, Task -> Lot -> ..., Machine -> Company, etc.).
//   - La firma operativa vive en Company y se referencia donde el negocio la
//     necesita (Machine, DailyReport, MachineActivity), nunca en Farm.
// ============================================================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  companies  Company[]
  users      User[]
  clients    Client[]
  inputs     Input[]
  laborTypes LaborType[]
}

model Company {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  cuit      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  userCompanies     UserCompany[]
  machines          Machine[]
  machineActivities MachineActivity[]
  dailyReports      DailyReport[]
  livestock         Livestock[]
  modules           Module[]

  @@index([tenantId])
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      UserRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  username            String?   @unique
  email               String    @unique
  passwordHash        String
  role                UserRole
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  version             Int       @default(1)
  deleted             Boolean   @default(false)

  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  companyMemberships  UserCompany[]
  refreshTokens       RefreshToken[]
  livestockEvents     LivestockEvent[]
  tasks               Task[]           @relation("TaskOperators")
  weightRecords       WeightRecord[]
  dailyReports        DailyReport[]    @relation("DailyReportOperator")
  approvedReports     DailyReport[]    @relation("DailyReportApprover")
  validatedReceptions Reception[]      @relation("ReceptionValidator")
  client              Client?

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Module {
  id        String    @id @default(uuid())
  name      String
  price     Float
  version   String
  createdAt DateTime  @default(now())
  companies Company[] @relation()
}

// ============================================================================
// Catalogos (tenant-owned, con version + deleted para pull versionado)
// ============================================================================

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  userId    String?  @unique
  cuit      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  farms      Farm[]
  receptions Reception[]
  stocks     Stock[]

  @@index([tenantId])
}

model Input {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  unit      InputUnit
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  recipeItems      RecipeItem[]
  dailyReportItems DailyReportItem[]
  receptionItems   ReceptionItem[]
  stocks           Stock[]

  @@index([tenantId])
}

model LaborType {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  version     Int      @default(1)
  deleted     Boolean  @default(false)

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  tasks        Task[]
  dailyReports DailyReport[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ============================================================================
// Campo / Lote
// ============================================================================

model Farm {
  id        String   @id @default(uuid())
  clientId  String
  name      String
  location  String?
  surface   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  client Client @relation(fields: [clientId], references: [id])
  lots   Lot[]

  @@index([clientId])
}

model Lot {
  id        String   @id @default(uuid())
  farmId    String
  name      String
  coords    String?
  area      Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)

  farm         Farm                @relation(fields: [farmId], references: [id])
  movements    LivestockMovement[]
  tasks        Task[]
  livestock    Livestock[]         @relation("LotLivestock")
  recipes      Recipe[]
  dailyReports DailyReport[]

  @@index([farmId])
}

// ============================================================================
// Tareas (pre-Sprint 2) — la firma NO vive aca: se resuelve en DailyReport
// ============================================================================

model Task {
  id            String     @id @default(uuid())
  lotId         String
  laborTypeId   String
  status        TaskStatus @default(PENDIENTE)
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedTaskAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  version       Int        @default(1)
  deleted       Boolean    @default(false)

  lot          Lot            @relation(fields: [lotId], references: [id])
  laborType    LaborType      @relation(fields: [laborTypeId], references: [id])
  operators    User[]         @relation("TaskOperators")
  machineLogs  MachineUsage[]
  dailyReports DailyReport[]

  @@index([lotId])
  @@index([laborTypeId])
  @@index([status])
}

// ============================================================================
// Produccion (CUU05) — R007, R008, R009
// ============================================================================

model Recipe {
  id              String       @id @default(uuid())
  lotId           String
  date            DateTime
  status          RecipeStatus @default(ACTIVA)
  observations    String?
  sprayVolume     Float
  sprayVolumeUnit String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lot   Lot          @relation(fields: [lotId], references: [id])
  items RecipeItem[]

  @@index([lotId])
  @@index([lotId, date])
}

model RecipeItem {
  id        String  @id @default(uuid())
  recipeId  String
  inputId   String
  dose      Float
  unit      String?
  loadOrder Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  input  Input  @relation(fields: [inputId], references: [id])

  @@index([recipeId])
  @@index([inputId])
}

model DailyReport {
  id              String            @id @default(uuid())
  operatorId      String
  companyId       String
  taskId          String
  lotId           String
  laborTypeId     String
  date            DateTime
  hectares        Float
  hours           Float
  status          DailyReportStatus @default(PENDIENTE_APROBACION)
  rejectionReason String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  operator  User              @relation("DailyReportOperator", fields: [operatorId], references: [id])
  approver  User?             @relation("DailyReportApprover", fields: [approvedBy], references: [id])
  company   Company           @relation(fields: [companyId], references: [id])
  task      Task              @relation(fields: [taskId], references: [id])
  lot       Lot               @relation(fields: [lotId], references: [id])
  laborType LaborType         @relation(fields: [laborTypeId], references: [id])
  items     DailyReportItem[]

  @@index([companyId, date])
  @@index([status, date])
  @@index([taskId])
  @@index([lotId])
  @@index([operatorId])
}

model DailyReportItem {
  id            String @id @default(uuid())
  dailyReportId String
  inputId       String
  quantity      Float
  unit          String

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  input       Input       @relation(fields: [inputId], references: [id])

  @@index([dailyReportId])
  @@index([inputId])
}

// ============================================================================
// Insumos / Stock (CUU06, CUU07) — R014, R015, R017
// ============================================================================

model Reception {
  id              String          @id @default(uuid())
  clientId        String
  date            DateTime
  status          ReceptionStatus @default(PENDIENTE_VALIDACION)
  rejectionReason String?
  validatedBy     String?
  validatedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  client    Client          @relation(fields: [clientId], references: [id])
  validator User?           @relation("ReceptionValidator", fields: [validatedBy], references: [id])
  items     ReceptionItem[]

  @@index([clientId])
  @@index([status])
}

model ReceptionItem {
  id                String @id @default(uuid())
  receptionId       String
  inputId           String
  // Expected quantity declared by the client when the reception is created
  // (R014, CUU06). It is the audit reference, not the amount that enters stock.
  quantity          Float
  // Quantity agreed by the administrator when the reception is validated
  // (mutuo acuerdo, R014). It is what enters the client stock (R017/CUU07), and
  // the shortage/surplus of the item is observable as validatedQuantity -
  // quantity (R015). Null while the reception is PENDIENTE_VALIDACION.
  validatedQuantity Float?
  unit              String

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  input     Input     @relation(fields: [inputId], references: [id])

  @@index([receptionId])
  @@index([inputId])
}

// Stock atribuido al cliente a nivel global (suma para todos sus lotes),
// no por lote individual (CUU06) y sin particion por firma (CUU07 es filtro
// de reporte, no de saldo).
model Stock {
  id        String   @id @default(uuid())
  clientId  String
  inputId   String
  quantity  Float
  unit      InputUnit
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  input  Input  @relation(fields: [inputId], references: [id])

  @@unique([clientId, inputId])
  @@index([inputId])
}

// ============================================================================
// Maquinaria (CUU08) — R018, R019, R020, R021
// ============================================================================

model Machine {
  id              String        @id @default(uuid())
  companyId       String
  name            String
  brand           String?
  status          MachineStatus @default(ACTIVA)
  entryDate       DateTime?
  maintenanceDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  version         Int           @default(1)
  deleted         Boolean       @default(false)

  company           Company           @relation(fields: [companyId], references: [id])
  usages            MachineUsage[]
  machineActivities MachineActivity[]

  @@index([companyId])
}

model MachineUsage {
  id           String   @id @default(uuid())
  taskId       String
  machineId    String
  initialFuel  Float?
  finalFuel    Float?
  usageHours   Float?
  observations String?
  createdAt    DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  task    Task    @relation(fields: [taskId], references: [id])

  @@index([machineId])
  @@index([taskId])
}

// Actividad de maquinaria NO atada a una tarea (compra de combustible,
// mantenimiento, reparacion). `companyId` es obligatorio porque R019 exige
// discriminar el gasto por firma.
model MachineActivity {
  id           String              @id @default(uuid())
  machineId    String
  companyId    String
  type         MachineActivityType
  date         DateTime
  liters       Float?
  receipt      String?
  cost         Float?
  spareParts   String?
  usageHours   Float?
  hectares     Float?
  observations String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([machineId, date])
  @@index([companyId])
  @@index([type, date])
}

// ============================================================================
// Infraestructura
// ============================================================================

// Foto polimorfica: no lleva FK porque apunta a distintas entidades.
model Photo {
  id         String          @id @default(uuid())
  entityType PhotoEntityType
  entityId   String
  localPath  String
  orderIndex Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
}

// ============================================================================
// Ganadero (fuera del contrato actual; se mantiene operativo)
// ============================================================================

model Livestock {
  id        String          @id @default(uuid())
  companyId String
  lotId     String?
  tagNumber String          @unique
  species   String
  breed     String?
  sex       String
  birthDate DateTime?
  status    LivestockStatus @default(ACTIVO)
  entryDate DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  version   Int             @default(1)
  deleted   Boolean         @default(false)

  company   Company             @relation(fields: [companyId], references: [id])
  events    LivestockEvent[]
  movements LivestockMovement[]
  weights   WeightRecord[]
  lot       Lot?                @relation("LotLivestock", fields: [lotId], references: [id])

  @@index([companyId])
  @@index([lotId])
}

model LivestockEvent {
  id           String    @id @default(uuid())
  livestockId  String
  operatorId   String?
  type         EventType
  observations String?
  vaccine      String?
  dose         Float?
  eventDate    DateTime
  createdAt    DateTime  @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id])
  operator  User?     @relation(fields: [operatorId], references: [id])

  @@index([livestockId])
}

model WeightRecord {
  id          String   @id @default(uuid())
  livestockId String
  operatorId  String?
  weight      Float
  measuredAt  DateTime
  createdAt   DateTime @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id])
  operator  User?     @relation(fields: [operatorId], references: [id])

  @@index([livestockId])
}

model LivestockMovement {
  id           String   @id @default(uuid())
  livestockId  String
  lotId        String
  movementDate DateTime
  observations String?
  createdAt    DateTime @default(now())

  livestock Livestock @relation(fields: [livestockId], references: [id])
  lot       Lot       @relation(fields: [lotId], references: [id])

  @@index([livestockId])
  @@index([lotId])
}

// ============================================================================
// Enums (valores en espanol)
// ============================================================================

enum UserRole {
  ADMIN
  OPERARIO
  SUPERVISOR
  PRODUCTOR
  CONTRATISTA
  VETERINARIO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  FINALIZADA
  CANCELADA
}

enum LivestockStatus {
  ACTIVO
  VENDIDO
  MUERTO
  ENFERMO
}

enum MachineStatus {
  ACTIVA
  MANTENIMIENTO
  FUERA_SERVICIO
}

enum EventType {
  VACUNACION
  TRATAMIENTO
  CASTRACION
  INSEMINACION
  PARTO
  ENFERMEDAD
}

enum DailyReportStatus {
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
}

enum ReceptionStatus {
  PENDIENTE_VALIDACION
  VALIDADA
  RECHAZADA
}

enum MachineActivityType {
  COMBUSTIBLE
  MANTENIMIENTO
  REPARACION
  USO_CAMPO
}

enum PhotoEntityType {
  PARTE_DIARIO
  RECEPCION
  ACTIVIDAD_MAQUINARIA
}

enum RecipeStatus {
  ACTIVA
  ARCHIVADA
}

enum InputUnit {
  L
  KG
  UNIT
}
