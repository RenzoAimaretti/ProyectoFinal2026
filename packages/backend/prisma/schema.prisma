generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String      @id @default(uuid())
  name      String
  cuit      String      @unique
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  version   Int         @default(1)
  deleted   Boolean     @default(false)
  farms     Farm[]
  livestock Livestock[]
  machines  Machine[]
  modules   Module[]
  users     User[]
}

model User {
  id              String           @id @default(uuid())
  companyId       String
  username        String           @unique
  passwordHash    String
  role            UserRole
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  version         Int              @default(1)
  deleted         Boolean          @default(false)
  livestockEvents LivestockEvent[]
  tasks           Task[]           @relation("TaskOperators")
  company         Company          @relation(fields: [companyId], references: [id])
  weightRecords   WeightRecord[]
}

model Farm {
  id        String   @id @default(uuid())
  companyId String
  name      String
  location  String?
  surface   Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  deleted   Boolean  @default(false)
  company   Company  @relation(fields: [companyId], references: [id])
  lots      Lot[]
}

model Lot {
  id        String              @id @default(uuid())
  farmId    String
  name      String
  coords    String?
  area      Float
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  version   Int                 @default(1)
  deleted   Boolean             @default(false)
  movements LivestockMovement[]
  farm      Farm                @relation(fields: [farmId], references: [id])
  tasks     Task[]
  // Relacion nueva a lotes y ganado para permitir que un lote tenga control de que animales tiene en un momento dado
  livestock Livestock[]         @relation("LotLivestock")
}

model TaskType {
  id          String  @id @default(uuid())
  name        String
  description String?
  tasks       Task[]
}

model Task {
  id            String         @id @default(uuid())
  lotId         String
  taskTypeId    String
  status        TaskStatus     @default(PENDIENTE)
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedTaskAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  version       Int            @default(1)
  deleted       Boolean        @default(false)
  machineLogs   MachineUsage[]
  lot           Lot            @relation(fields: [lotId], references: [id])
  //Se cambio de relacion de un solo usuario a varios operadores para permitir que varias personas puedan trabajar en la misma tarea
  operators     User[]         @relation("TaskOperators")
  taskType      TaskType       @relation(fields: [taskTypeId], references: [id])
}

model Machine {
  id              String         @id @default(uuid())
  companyId       String
  name            String
  brand           String?
  status          MachineStatus  @default(ACTIVA)
  entryDate       DateTime?
  maintenanceDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  version         Int            @default(1)
  deleted         Boolean        @default(false)
  company         Company        @relation(fields: [companyId], references: [id])
  usages          MachineUsage[]
}

model MachineUsage {
  id           String   @id @default(uuid())
  taskId       String
  machineId    String
  initialFuel  Float?
  finalFuel    Float?
  usageHours   Float?
  observations String?
  createdAt    DateTime @default(now())
  machine      Machine  @relation(fields: [machineId], references: [id])
  task         Task     @relation(fields: [taskId], references: [id])
}

model Module {
  id        String   @id @default(uuid())
  name      String
  price     Float
  version   String
  createdAt DateTime @default(now())
  companies   Company[]  @relation()
}

model Livestock {
  // No es tonto tener el id de la compania? ya por transitividad se saca del lote
  id        String              @id @default(uuid())
  companyId String
  lotId     String? // Relacion nueva a lotes para permitir que un animal pueda estar asignado a un lote
  tagNumber String              @unique
  species   String
  breed     String?
  sex       String
  birthDate DateTime?
  status    LivestockStatus     @default(ACTIVO)
  entryDate DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  version   Int                 @default(1)
  deleted   Boolean             @default(false)
  company   Company             @relation(fields: [companyId], references: [id])
  events    LivestockEvent[]
  movements LivestockMovement[]
  weights   WeightRecord[]
  // Yo creo que esta no es necesaria por reglas de transitividad, pero la dejo por si acaso para facilitar consultas
  lot       Lot?                @relation("LotLivestock", fields: [lotId], references: [id])
}

model LivestockEvent {
  id           String    @id @default(uuid())
  livestockId  String
  operatorId   String?
  type         EventType
  observations String?
  vaccine      String?
  dose         Float?
  eventDate    DateTime
  createdAt    DateTime  @default(now())
  livestock    Livestock @relation(fields: [livestockId], references: [id])
  operator     User?     @relation(fields: [operatorId], references: [id])
}

model WeightRecord {
  id          String    @id @default(uuid())
  livestockId String
  operatorId  String?
  weight      Float
  measuredAt  DateTime
  createdAt   DateTime  @default(now())
  livestock   Livestock @relation(fields: [livestockId], references: [id])
  operator    User?     @relation(fields: [operatorId], references: [id])
}

model LivestockMovement {
  id           String    @id @default(uuid())
  livestockId  String
  lotId        String
  movementDate DateTime
  observations String?
  createdAt    DateTime  @default(now())
  livestock    Livestock @relation(fields: [livestockId], references: [id])
  lot          Lot       @relation(fields: [lotId], references: [id])
}

enum UserRole {
  ADMIN
  OPERARIO
  PRODUCTOR
  CONTRATISTA
  VETERINARIO
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  FINALIZADA
  CANCELADA
}

enum LivestockStatus {
  ACTIVO
  VENDIDO
  MUERTO
  ENFERMO
}

enum MachineStatus {
  ACTIVA
  MANTENIMIENTO
  FUERA_SERVICIO
}

enum EventType {
  VACUNACION
  TRATAMIENTO
  CASTRACION
  INSEMINACION
  PARTO
  ENFERMEDAD
}
