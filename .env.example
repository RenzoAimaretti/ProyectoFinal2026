# Copy this file to `.env` (gitignored) and set real values.

# --- docker-compose (place this .env at the repository root) ---
POSTGRES_DB=proyectofinal
POSTGRES_USER=devuser
POSTGRES_PASSWORD=change-me

# --- backend (place these in packages/backend/.env) ---
DATABASE_URL=postgresql://devuser:change-me@localhost:5433/proyectofinal?schema=public
JWT_SECRET=change-me-to-a-long-random-string
SEED_ADMIN_PASSWORD=change-me
# Optional: default password for newly created client users (random if unset)
CLIENT_DEFAULT_PASSWORD=
